{
  "name": "aoc2025",
  "version": "1.0.0",
  "description": "My solutions for Advent of Code 2025",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "check": "npm run lint && npm run build",
    "check:fix": "npm run lint:fix && npm run build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "npm run build && tsx src/index.ts",
    "test": "jest",
    "day01": "tsx src/day01.ts",
    "day02": "tsx src/day02.ts",
    "day03": "tsx src/day03.ts",
    "day04": "tsx src/day04.ts",
    "day05": "tsx src/day05.ts",
    "day06": "tsx src/day06.ts",
    "day07": "tsx src/day07.ts",
    "day09": "tsx src/day09/main.ts",
    "day11": "tsx src/day11.ts",
    "day12": "tsx src/day12.ts"
  },
  "keywords": [],
  "author": "Stanislav Schmidt",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.2",
    "@babel/preset-typescript": "^7.28.5",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.2",
    "babel-jest": "^30.3.0",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.3.0",
    "prettier": "3.8.1",
    "ts-jest": "^29.4.9",
    "tsx": "^4.22.4",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0"
  },
  "prettier": {
    "printWidth": 120
  }
}
